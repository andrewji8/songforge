# SongForge — copy to .env and adjust. All vars are prefixed SF_ in app code.

# --- App ---
SF_ENVIRONMENT=dev
SF_LOG_LEVEL=INFO
SF_CORS_ORIGINS=http://localhost:5173

# --- Storage / DB ---
# MVP: local SQLite. Production: postgresql+psycopg://user:pass@host:5432/songforge
#SF_DATABASE_URL=postgresql+psycopg://sf:sf@postgres:5432/songforge
#SF_STORAGE_DIR=.data/storage

# --- Audio / mastering targets (stream-ready loudness) ---
SF_TARGET_LUFS=-14.0
SF_TRUE_PEAK_DB=-1.0

# --- Pipeline / SLO ---
SF_PREVIEW_SECONDS=30
SF_PREVIEW_SLO_SECONDS=25
SF_DEFAULT_DURATION_SECS=190
SF_MAX_STAGE_ATTEMPTS=3

# --- Cost control (USD) ---
SF_JOB_BUDGET_USD=2.00
SF_DAILY_COST_CAP_USD=500.0
SF_PRICING_PREVIEW_USD=0.02
SF_PRICING_FULL_USD=0.15
SF_PRICING_MIX_MASTER_USD=0.01

# --- Worker (embedded) ---
SF_ENABLE_WORKER=true
SF_WORKER_CONCURRENCY=2

# --- Music provider: simulated | http ---
SF_PROVIDER=simulated
# For the http gateway (Suno/OpenAudio-style):
#SF_PROVIDER=http
#SF_PROVIDER_BASE_URL=https://your-music-api.example.com
#SF_PROVIDER_API_KEY=***

# --- LLM (OpenAI-compatible) for intent parsing + lyrics. Leave blank to use heuristics. ---
#SF_LLM_BASE_URL=https://api.openai.com/v1
#SF_LLM_API_KEY=
SF_LLM_MODEL=gpt-4o-mini

# --- Observability (optional OTLP collector, e.g. Grafana Tempo) ---
#SF_OTEL_ENDPOINT=http://localhost:4318
